{
 "label": "PILOT",
 "config": {
  "PILOT": true,
  "experiment": "E2 PILOT of idea #6 (aligned-VAE probe) and #7 (VAE double-reconstruction ratio), docs/04-phase4-plan.md Amendment 8; does not count toward the stop rule",
  "seed": 0,
  "n_boot": 2000,
  "vaes": {
   "sd-vae-ft-mse": {
    "repo": "stabilityai/sd-vae-ft-mse",
    "revision": "31f26fdeee1355a5c34592e401dd41e45d25a493"
   }
  },
  "vae_io": "uint8 -> float32 [-1,1] -> encode -> latent_dist.mode() (the posterior MEAN, deterministic) -> decode -> (y+1)/2 clamped to [0,1] -> quantized to uint8 (np.rint) before saving / re-encoding; fp32, TF32 off; GPU batch <= 4 (shared GPU: OOM -> batch halved)",
  "arms": {
   "orig": "experiments/004-phase4-features/pilot/splits_pilot.csv",
   "fov512": "experiments/004-phase4-features/pilot/splits_pilot_fov512.csv"
  },
  "conditions": [
   "clean",
   "jpeg75_resize05"
  ],
  "timing_gate": {
   "n_images": 20,
   "pass": "one encode+decode of one 512x512 image",
   "limit_s": 1.0,
   "cut": "30 fakes per generator and 150 natives in the #7 test set"
  },
  "six_generators": [
   "dalle2",
   "dalle3",
   "firefly",
   "midjourney-v5",
   "stable-diffusion-2",
   "stable-diffusion-xl"
  ],
  "sd_family": [
   "stable-diffusion-2",
   "stable-diffusion-xl"
  ],
  "other_family": [
   "dalle2",
   "dalle3",
   "firefly",
   "midjourney-v5"
  ],
  "features": "004 pipeline: DINOv2-base (HF facebook/dinov2-base), secondary backbone blocks 4/8/12 CLS+mean, primary = last 1536 columns, 224 center crop, batch 20, TF32 off; existing images from cached 004 features (load_features_aligned, subdir pilot / pilot_fov512)",
  "six_A": "probe on train reals (297: 99 native + 99 WA + 99 FBH) vs aligned fakes (594 = 297 x 2 VAEs), trained on CLEAN features, balanced logistic, grouped CV (group = source real sha256); evaluated at clean and jpeg75_resize05 on test natives (358) vs ALL 120 fakes per generator (005 LOGO convention)",
  "six_B": "005 A0: b0_train (99 natives + generator fakes) LOGO, grouped CV (group = sha256), class_weight balanced",
  "six_C": "B's LOGO training rows + the 594 aligned fakes (group = source real sha256). C_all_reals = C plus the 198 WA/FBH train reals (sensitivity)",
  "six_criteria": {
   "A_PASS": "macro AUROC at jpeg75_resize05 >= 0.85 (orig arm)",
   "A_FAIL": "< 0.75",
   "C_vs_B": "+0.02 at jpeg75_resize05 only if B LOGO-macro at jpeg75_resize05 <= 0.96, else no headroom / uninformative"
  },
  "seven": {
   "x": "the conditioned test image (clean: the 512 crop; jpeg75_resize05: the 256x256 image after the condition), float [0,1]",
   "x1": "VAE(x) quantized",
   "x2": "VAE(x1) quantized",
   "ratio": "||x-x1||_2 / ||x1-x2||_2 over all pixels in [0,1] float space; min over the 2 VAEs; fake-score = -ratio (fixed, never flipped)",
   "baseline_single": "||x-x1||_2, min over the 2 VAEs; fake-score = -min (lower error = fake, AEROBLADE premise, fixed); L2 instead of LPIPS",
   "texture": "mean |4-neighbour Laplacian| of the grayscale 224 center crop of the conditioned image; sign chosen on calib natives vs train-split fakes (calib has no fakes)",
   "test_set": "split == test: 358 VISION natives (25 devices) vs 60 fakes x 6 generators",
   "PASS": "ratio macro AUROC clean >= single-pass + 0.05 AND >= 0.65 at jpeg75_resize05 AND beats texture (both conditions); FAIL otherwise; UNINFORMATIVE if the clean AUROC CI includes 0.5; label arm orig"
  },
  "bootstrap": "lib/metrics.bootstrap_weights: reals by device, fakes by image stratified per generator, one plan shared by all methods (paired); texture check on train reals vs aligned fakes: device clusters moved together (aligned fake carries its source real's device)",
  "d008": {
   "vae": "CUDA vs CPU, 32 fixed images (16 native + 16 fake, test, orig, clean), max |dpixel| of float output <= 1e-3 (x1 and x2)",
   "probe": "32 aligned fakes, DINOv2 features CUDA(cache) vs CPU, scaled |dF| <= 1e-3 and |dlogit| <= 1e-3 for probes A and C_full",
   "tf32": false
  },
  "outputs": "pilot/{results.json,tables.md,scores_long.csv.gz,d008_guard.json,timing.json,run.log}; caches in cache/ (git-ignored)"
 },
